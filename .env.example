# Copy this file to .env and fill in the key for the provider you use.

# Which chat model powers the supervisor and every specialist agent.
# Format: "<provider>:<model_name>". The provider must match one of the
# API keys below.
FLIGHT_OPS_MODEL=anthropic:claude-sonnet-5

# Set only the key matching your chosen provider above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
